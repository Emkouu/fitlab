// FitLab — MVP schema (SPEC §4)
// Prisma 7 generates the client into lib/generated/prisma (see CLAUDE.md).

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 the connection URL is configured in prisma.config.ts,
  // not here. Migrations use DIRECT_URL; runtime Prisma Client uses
  // DATABASE_URL (pooled) via `new PrismaClient({ datasourceUrl })`.
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  admin
  coach
  member
}

/// All six booking states. `cancelled` and `no_show` free the spot;
/// the other four count as "active" against capacity.
enum BookingStatus {
  booked
  pending_deposit
  paid
  attended
  no_show
  cancelled
}

enum BookingSource {
  card
  onsite_deposit
  balance
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum NotificationType {
  spot_available
  class_cancelled
  reminder_24h
  reminder_2h
  new_booking
  booking_cancelled
}

// ─── Core ──────────────────────────────────────────────────────────────────────

model Studio {
  id                 String @id @default(cuid())
  name               String
  slug               String @unique
  /// Hours before class start within which a cancellation forfeits the deposit (SPEC §5.4).
  cancelWindowHours  Int    @default(4)
  /// Studio contact + social info, surfaced on the landing page and sticky CTA.
  address            String?
  phone              String?
  facebookUrl        String?
  instagramUrl       String?
  /// Default deposit (minor units / EUR cents) pre-filled on the new-class form.
  defaultDeposit     Int    @default(2000)
  /// Final price of one group class (minor units / EUR cents), settled on site.
  /// Shown on the schedule and in the booking modal — the acquirer requires the
  /// end price of the service to be visible (Fibank instruction §I.8/§I.9).
  /// A Practice may override it via `Practice.priceMinor`.
  defaultClassPrice  Int    @default(1000)
  /// Admin kill-switch for the card deposit path. When false the booking UI
  /// hides „Плати с карта" and the server rejects source=card bookings.
  cardPaymentsEnabled Boolean @default(true)

  classes ScheduledClass[]
}

/// Class type / category — "Виняса Флоу", "Пилатес", …
model Practice {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  /// Optional description — what this practice is, what to expect.
  /// Shown in the class info modal on the public schedule.
  description String?
  /// Per-practice price override (minor units / EUR cents). NULL → the class
  /// costs `Studio.defaultClassPrice`. Read through `lib/pricing.ts`, never
  /// directly, so the fallback stays in one place.
  priceMinor  Int?

  classes  ScheduledClass[]
  trainers Trainer[] @relation("TrainerSpecialties")
}

model Trainer {
  id          String   @id @default(cuid())
  name        String
  photoUrl    String?
  bio         String?

  // Many-to-many with Practice for trainer specialties
  specialties Practice[] @relation("TrainerSpecialties")

  // A trainer MAY be linked to a login account (1:1, optional).
  user        User?

  // Many-to-many: some classes have two trainers ("Даниил & Юна").
  classes     ScheduledClass[] @relation("ClassTrainers")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledClass {
  id              String   @id @default(cuid())
  startAt         DateTime
  /// Duration in MINUTES, stored explicitly (export varies 45–240; never assume).
  durationMinutes Int
  capacity        Int
  /// Stored in minor units (EUR cents) to avoid float drift. 2000 = €20.00.
  depositAmount   Int
  isSpecialEvent  Boolean  @default(false)
  eventNotes      String?
  /// Promo image (public URL) shown above the card on the „Събития" screen.
  /// Only meaningful for special events; NULL for regular classes.
  imageUrl        String?

  practiceId      String
  practice        Practice @relation(fields: [practiceId], references: [id])

  studioId        String
  studio          Studio   @relation(fields: [studioId], references: [id])

  trainers        Trainer[] @relation("ClassTrainers")
  bookings        Booking[]
  waitlist        Waitlist[]
  notifications   Notification[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cancelledAt     DateTime?

  @@index([startAt])
  @@index([studioId, startAt])
}

model Booking {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id])

  status           BookingStatus
  source           BookingSource

  paymentId        String?        @unique
  payment          Payment?       @relation(fields: [paymentId], references: [id])

  createdAt        DateTime       @default(now())
  cancelledAt      DateTime?

  /// Timestamps for class-reminder emails. NULL = not yet sent. Set by the
  /// /api/cron/reminders job so a reminder is never sent twice.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  /// For on-site (`onsite_deposit`) bookings only: how the client pays at the
  /// desk — "cash" | "subscription" | "multisport". Captured from the booking
  /// modal, editable by staff in Attendance. NULL for card/balance bookings.
  onsiteMethod String?
  /// When staff marked the on-site deposit as settled ("Разплати" in
  /// Attendance). NULL = not yet collected. Orthogonal to attendance status —
  /// payment and attendance are independent axes.
  depositSettledAt DateTime?

  /// Proof that the client ticked „Приемам Общите условия" before the booking
  /// was created — the acquirer requires explicit consent before the client is
  /// ever redirected to the card-data page. NULL only for legacy rows.
  termsAcceptedAt  DateTime?
  /// Which revision of the terms was accepted (`POLICIES_LAST_UPDATED`), so a
  /// later edit of the terms can't silently rewrite what the client agreed to.
  termsVersion     String?

  /// Prevents double-booking the same class by the same user (SPEC §5.2).
  /// Only applies to active (non-cancelled) bookings, allowing re-booking after cancellation.
  @@unique([userId, scheduledClassId], map: "unique_active_booking", where: raw("status != 'cancelled'"))
  @@index([scheduledClassId, status])
}

model Payment {
  id                    String        @id @default(cuid())
  /// Minor units, mirrors ScheduledClass.depositAmount.
  amount                Int
  currency              String        @default("EUR") // ISO 4217; FitLab is EUR everywhere.
  status                PaymentStatus

  stripePaymentIntentId String?       @unique
  stripeCheckoutId      String?       @unique

  // ── Fibank ECOMM (виртуален ПОС) ────────────────────────────────────────
  // The live card provider. Card data is entered on the bank's own page; we
  // only ever hold the transaction identifier and the result fields the bank
  // hands back. The acquirer requires every response field to be preserved
  // (integration manual §4.2).
  /// 28-char base64 identifier returned by `command=v`. The key we use to ask
  /// the bank for a result and to issue a refund against the same card.
  ecommTransId          String?       @unique
  /// RESULT (OK | FAILED | CREATED | PENDING | DECLINED | REVERSED | …).
  ecommResult           String?
  /// RESULT_CODE — 3-digit processing code, informative only.
  ecommResultCode       String?
  /// 3DSECURE authentication outcome, informative only.
  ecomm3dSecure         String?
  /// Retrieval reference number — lets the bank trace the transaction.
  ecommRrn              String?
  /// Approval code (successful transactions only).
  ecommApprovalCode     String?
  /// Masked card number as returned by the bank, e.g. "4***********6789".
  /// Never a full PAN — we neither receive nor store one.
  ecommCardMask         String?

  // ── Refund back to the same card (Fibank instruction §I.16) ─────────────
  /// Identifier of the refund transaction (`command=k` → REFUND_TRANS_ID).
  ecommRefundTransId    String?
  /// How much was sent back, in minor units. May be less than `amount`.
  refundedAmount        Int?
  refundedAt            DateTime?

  /// Append-only log of superseded attempts on this booking.
  ///
  /// A declined card can be retried, and ECOMM will not accept a second attempt
  /// on a spent `trans_id` — so a retry registers a fresh transaction and the
  /// `ecomm*` fields above start over. Without this column the record of the
  /// declined attempt would be overwritten, and the acquirer requires every
  /// response to be preserved for every card payment (manual §4.2).
  ///
  /// Shape: array of `{ transId, result, resultCode, threeDSecure, rrn,
  /// approvalCode, cardMask, amount, supersededAt }`, oldest first.
  ecommHistory          Json?

  booking               Booking?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model User {
  id              String    @id @default(cuid())
  /// Link to the Supabase auth user. Set on first sign-in via the callback.
  supabaseUserId  String?   @unique
  /// E.164. Primary identifier once SMS OTP is live. Nullable so that
  /// magic-link users (email-first) can sign in before they verify a phone.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// Email — magic-link fallback; primary identifier for users who haven't
  /// verified a phone yet.
  email           String?   @unique
  fullName        String?
  role            Role      @default(member)

  /// Optional 1:1 link to a Trainer record (a coach who also logs in).
  trainerId       String?   @unique
  trainer         Trainer?  @relation(fields: [trainerId], references: [id])

  /// Deposit balance in minor units (EUR cents). Accumulated from refunded bookings.
  depositBalance  Int       @default(0)

  bookings        Booking[]
  waitlist        Waitlist[]
  notifications   Notification[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Phase 2 stubs (table-ready, unused in MVP) ───────────────────────────────
// Tables exist so adding the features later doesn't require a painful migration.
// Do NOT wire them into business logic in MVP (SPEC §7).

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Waitlist {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id])
  createdAt        DateTime       @default(now())
  /// When we sent the spot_available notification (NULL = not yet notified).
  notifiedAt       DateTime?

  @@unique([userId, scheduledClassId])
  @@index([scheduledClassId, notifiedAt])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  type             NotificationType
  message          String
  scheduledClassId String?
  scheduledClass   ScheduledClass?  @relation(fields: [scheduledClassId], references: [id])
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model RecurringRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

/// Loyalty-program partner brand. Shown on the client Profile page with the
/// partner's logo, discount promo code, and a link to their site. Managed by
/// admins at /admin/partners.
model Partner {
  id          String   @id @default(cuid())
  name        String
  /// Short benefit line shown under the name, e.g. "15% отстъпка с кода".
  description String?
  logoUrl     String?
  siteUrl     String?
  promoCode   String?
  /// Hidden from the Profile page when false — soft off-switch, no delete.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
