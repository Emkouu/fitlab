// FitLab — MVP schema (SPEC §4)
// Prisma 7 generates the client into lib/generated/prisma (see CLAUDE.md).

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 the connection URL is configured in prisma.config.ts,
  // not here. Migrations use DIRECT_URL; runtime Prisma Client uses
  // DATABASE_URL (pooled) via `new PrismaClient({ datasourceUrl })`.
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  admin
  coach
  member
}

/// All six booking states. `cancelled` and `no_show` free the spot;
/// the other four count as "active" against capacity.
enum BookingStatus {
  booked
  pending_deposit
  paid
  attended
  no_show
  cancelled
}

enum BookingSource {
  card
  onsite_deposit
  balance
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

/// How a standing deposit reached (or left) a client's profile.
/// `received` = money in, `returned` = money back to the client,
/// `correction` = an admin edited the balance by hand on the client form.
enum DepositEntryKind {
  received
  returned
  correction
}

/// Where the money physically moved. `manual` is a balance correction with no
/// cash or card behind it.
enum DepositEntryMethod {
  cash
  card
  manual
}

enum NotificationType {
  spot_available
  class_cancelled
  reminder_24h
  reminder_2h
  new_booking
  booking_cancelled
}

// ─── Core ──────────────────────────────────────────────────────────────────────

model Studio {
  id                  String  @id @default(cuid())
  name                String
  slug                String  @unique
  /// Hours before class start within which a cancellation forfeits the deposit (SPEC §5.4).
  cancelWindowHours   Int     @default(4)
  /// Studio contact + social info, surfaced on the landing page and sticky CTA.
  address             String?
  phone               String?
  facebookUrl         String?
  instagramUrl        String?
  /// The deposit required to reserve online (minor units / EUR cents), set in
  /// Админ → Настройки. Applies to every class unless that class carries its
  /// own `ScheduledClass.depositAmount`. Resolve ONLY through
  /// `depositAmountMinor()` in lib/deposit.ts.
  defaultDeposit      Int     @default(1000)
  /// Final price of one group class (minor units / EUR cents), settled on site.
  /// Shown on the schedule and in the booking modal — the acquirer requires the
  /// end price of the service to be visible (Fibank instruction §I.8/§I.9).
  /// A Practice may override it via `Practice.priceMinor`.
  defaultClassPrice   Int     @default(1000)
  /// Admin kill-switch for the card deposit path. When false the booking UI
  /// hides „Плати с карта" and the server rejects source=card bookings.
  cardPaymentsEnabled Boolean @default(true)

  classes ScheduledClass[]
}

/// Class type / category — "Виняса Флоу", "Пилатес", …
model Practice {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  /// Optional description — what this practice is, what to expect.
  /// Shown in the class info modal on the public schedule.
  description String?
  /// Per-practice price override (minor units / EUR cents). NULL → the class
  /// costs `Studio.defaultClassPrice`. Read through `lib/pricing.ts`, never
  /// directly, so the fallback stays in one place.
  priceMinor  Int?

  classes  ScheduledClass[]
  trainers Trainer[]        @relation("TrainerSpecialties")
}

model Trainer {
  id       String  @id @default(cuid())
  name     String
  photoUrl String?
  bio      String?

  // Many-to-many with Practice for trainer specialties
  specialties Practice[] @relation("TrainerSpecialties")

  // A trainer MAY be linked to a login account (1:1, optional).
  user User?

  // Many-to-many: some classes have two trainers ("Даниил & Юна").
  classes ScheduledClass[] @relation("ClassTrainers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledClass {
  id              String   @id @default(cuid())
  startAt         DateTime
  /// Duration in MINUTES, stored explicitly (export varies 45–240; never assume).
  durationMinutes Int
  capacity        Int
  /// Per-class deposit override, in minor units (EUR cents). NULL = inherit
  /// `Studio.defaultDeposit`. Resolve ONLY through `depositAmountMinor()` in
  /// lib/deposit.ts — never read this column directly. A stored 0 is a real
  /// amount (a class that needs no guarantee), not "unset".
  depositAmount   Int?
  isSpecialEvent  Boolean  @default(false)
  eventNotes      String?
  /// Promo image (public URL) shown above the card on the „Събития" screen.
  /// Only meaningful for special events; NULL for regular classes.
  imageUrl        String?

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  trainers      Trainer[]      @relation("ClassTrainers")
  bookings      Booking[]
  waitlist      Waitlist[]
  notifications Notification[]

  /// When the trainers of THIS class were reminded by email that they are
  /// teaching it. Per class, not per booking — a trainer gets one letter with
  /// the roster, however many clients are enrolled. NULL = not yet sent; set by
  /// /api/cron/reminders so a reminder is never sent twice.
  trainerReminder24hSentAt DateTime?
  trainerReminder2hSentAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([startAt])
  @@index([studioId, startAt])
}

model Booking {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id])

  status BookingStatus
  source BookingSource

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  /// Timestamps for class-reminder emails. NULL = not yet sent. Set by the
  /// /api/cron/reminders job so a reminder is never sent twice.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  /// Set when a client who had never booked anything used the „първо
  /// посещение" path: reserved without paying the deposit, so they can see the
  /// studio before any money is asked for. Eligibility is „no bookings at all",
  /// which makes the privilege once-only on its own — this column is the record
  /// staff need in Attendance, not the gate.
  isFirstVisit Boolean @default(false)

  /// When the „недовършен депозит" nudge was emailed. NULL = not sent. Set by
  /// /api/cron/reminders so an abandoned card payment is chased exactly once.
  depositReminderSentAt DateTime?

  /// For on-site (`onsite_deposit`) bookings only: how the client pays at the
  /// desk — "cash" | "subscription" | "multisport". Captured from the booking
  /// modal, editable by staff in Attendance. NULL for card/balance bookings.
  onsiteMethod     String?
  /// When staff marked the on-site deposit as settled ("Разплати" in
  /// Attendance). NULL = not yet collected. Orthogonal to attendance status —
  /// payment and attendance are independent axes.
  depositSettledAt DateTime?

  /// How much of the standing deposit this booking consumed (EUR cents), set
  /// when it was burned by a no-show or a late cancel. NULL = never burned.
  /// Recorded because the deposit amount is configurable: correcting a
  /// mis-tapped no_show must give back exactly what was taken, not whatever the
  /// setting happens to say now.
  depositBurnedMinor Int?

  /// Proof that the client ticked „Приемам Общите условия" before the booking
  /// was created — the acquirer requires explicit consent before the client is
  /// ever redirected to the card-data page. NULL only for legacy rows.
  termsAcceptedAt DateTime?
  /// Which revision of the terms was accepted (`POLICIES_LAST_UPDATED`), so a
  /// later edit of the terms can't silently rewrite what the client agreed to.
  termsVersion    String?

  /// Prevents double-booking the same class by the same user (SPEC §5.2).
  /// Only applies to active (non-cancelled) bookings, allowing re-booking after cancellation.
  @@unique([userId, scheduledClassId], map: "unique_active_booking", where: raw("status != 'cancelled'"))
  @@index([scheduledClassId, status])
}

model Payment {
  id       String        @id @default(cuid())
  /// Minor units, mirrors ScheduledClass.depositAmount.
  amount   Int
  currency String        @default("EUR") // ISO 4217; FitLab is EUR everywhere.
  status   PaymentStatus

  stripePaymentIntentId String? @unique
  stripeCheckoutId      String? @unique

  // ── Fibank ECOMM (виртуален ПОС) ────────────────────────────────────────
  // The live card provider. Card data is entered on the bank's own page; we
  // only ever hold the transaction identifier and the result fields the bank
  // hands back. The acquirer requires every response field to be preserved
  // (integration manual §4.2).
  /// 28-char base64 identifier returned by `command=v`. The key we use to ask
  /// the bank for a result and to issue a refund against the same card.
  ecommTransId      String? @unique
  /// RESULT (OK | FAILED | CREATED | PENDING | DECLINED | REVERSED | …).
  ecommResult       String?
  /// RESULT_CODE — 3-digit processing code, informative only.
  ecommResultCode   String?
  /// 3DSECURE authentication outcome, informative only.
  ecomm3dSecure     String?
  /// Retrieval reference number — lets the bank trace the transaction.
  ecommRrn          String?
  /// Approval code (successful transactions only).
  ecommApprovalCode String?
  /// Masked card number as returned by the bank, e.g. "4***********6789".
  /// Never a full PAN — we neither receive nor store one.
  ecommCardMask     String?

  // ── Refund back to the same card (Fibank instruction §I.16) ─────────────
  /// Identifier of the refund transaction (`command=k` → REFUND_TRANS_ID).
  ecommRefundTransId String?
  /// How much was sent back, in minor units. May be less than `amount`.
  refundedAmount     Int?
  refundedAt         DateTime?

  /// Append-only log of superseded attempts on this booking.
  ///
  /// A declined card can be retried, and ECOMM will not accept a second attempt
  /// on a spent `trans_id` — so a retry registers a fresh transaction and the
  /// `ecomm*` fields above start over. Without this column the record of the
  /// declined attempt would be overwritten, and the acquirer requires every
  /// response to be preserved for every card payment (manual §4.2).
  ///
  /// Shape: array of `{ transId, result, resultCode, threeDSecure, rrn,
  /// approvalCode, cardMask, amount, supersededAt }`, oldest first.
  ecommHistory Json?

  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Every time a standing deposit is taken from a client or given back.
///
/// The deposit lives as a single number on `User.depositBalance`, which says
/// what the client holds right now but not that it ever arrived. A deposit paid
/// in cash and recorded by an admin used to leave no trace at all: it never
/// showed up in Статистика, and „усвоени депозити" could only report money the
/// bank had confirmed. This table is that trace — one row per movement,
/// append-only, so a month can be closed on what actually came in.
///
/// Burns are deliberately NOT recorded here: a burn is written on the booking
/// (`Booking.depositBurnedMinor`), which is the only place that can also say
/// which class was missed and why. Statistics read burns from there.
model DepositEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("DepositEntries", fields: [userId], references: [id])

  /// EUR cents, signed: positive when the studio received the deposit,
  /// negative when it went back to the client (or an admin lowered it).
  amountMinor Int
  kind        DepositEntryKind
  method      DepositEntryMethod

  /// The admin who recorded it. NULL for a card payment the client made
  /// themselves — nobody at the desk was involved.
  recordedById String?
  recordedBy   User?   @relation("DepositEntriesRecorded", fields: [recordedById], references: [id])

  /// The card `Payment` behind a `card` entry, when there is one. Plain column,
  /// not a relation: an entry outlives whatever row it points at.
  paymentId String?

  /// Free-text context for the desk („платен в брой на рецепцията").
  note String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model User {
  id              String    @id @default(cuid())
  /// Link to the Supabase auth user. Set on first sign-in via the callback.
  supabaseUserId  String?   @unique
  /// E.164. Primary identifier once SMS OTP is live. Nullable so that
  /// magic-link users (email-first) can sign in before they verify a phone.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// Email — magic-link fallback; primary identifier for users who haven't
  /// verified a phone yet.
  email           String?   @unique
  fullName        String?
  role            Role      @default(member)

  /// Optional 1:1 link to a Trainer record (a coach who also logs in).
  trainerId String?  @unique
  trainer   Trainer? @relation(fields: [trainerId], references: [id])

  /// Deposit balance in minor units (EUR cents). Accumulated from refunded bookings.
  depositBalance Int @default(0)

  bookings      Booking[]
  waitlist      Waitlist[]
  notifications Notification[]
  /// Deposit movements on this profile, and the ones this user recorded for
  /// somebody else (admins only).
  depositEntries         DepositEntry[] @relation("DepositEntries")
  depositEntriesRecorded DepositEntry[] @relation("DepositEntriesRecorded")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Phase 2 stubs (table-ready, unused in MVP) ───────────────────────────────
// Tables exist so adding the features later doesn't require a painful migration.
// Do NOT wire them into business logic in MVP (SPEC §7).

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Waitlist {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id])
  createdAt        DateTime       @default(now())
  /// When we sent the spot_available notification (NULL = not yet notified).
  notifiedAt       DateTime?

  @@unique([userId, scheduledClassId])
  @@index([scheduledClassId, notifiedAt])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  type             NotificationType
  message          String
  scheduledClassId String?
  scheduledClass   ScheduledClass?  @relation(fields: [scheduledClassId], references: [id])
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model RecurringRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

/// Loyalty-program partner brand. Shown on the client Profile page with the
/// partner's logo, discount promo code, and a link to their site. Managed by
/// admins at /admin/partners.
model Partner {
  id          String   @id @default(cuid())
  name        String
  /// Short benefit line shown under the name, e.g. "15% отстъпка с кода".
  description String?
  logoUrl     String?
  siteUrl     String?
  promoCode   String?
  /// Hidden from the Profile page when false — soft off-switch, no delete.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Who the studio's OWN emails come from — booking confirmations, class
/// reminders to clients and to trainers, the unfinished-deposit nudge,
/// „освободи се място", the notifications to admins. They all leave through
/// **Resend**; only the sender identity is configurable here, so changing it
/// needs no deploy.
///
/// Single row (`id = "default"`), editable in Админ → Настройки → Системни
/// настройки.
///
/// Login codes are NOT sent from here: those come from Supabase Auth, which has
/// its own SMTP (Resend) configured in the Supabase dashboard. Nothing in this
/// table can affect a user's ability to sign in.
model EmailSettings {
  id String @id @default("default")

  // ── Retired: the studio-SMTP route ──────────────────────────────────────
  // No code path reads or writes these any more. Resend is the single way out
  // (lib/email/transport.ts); the SMTP option was removed so an email can never
  // leave by a route nobody is watching. Kept only so the removal needed no
  // destructive migration — `updateEmailSettingsAction` clears them, password
  // ciphertext included, on the next save.
  smtpEnabled  Boolean @default(false)
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean @default(true)
  smtpUser     String?
  smtpPassword String?

  /// Envelope sender. "FitLab Varna" <info@fitlabvarna.com>
  fromName  String?
  fromEmail String?
  replyTo   String?

  updatedAt      DateTime @updatedAt
  /// Who last saved this, for the [admin-audit] trail.
  updatedByEmail String?
}
