# ─── Database (Prisma → Postgres) ──────────────────────────────────────────────
# Supabase pooled connection (PgBouncer, transaction mode) for the app at runtime.
# Note: env vars in this file are NOT auto-loaded by Prisma — prisma.config.ts
# must `import "dotenv/config"` (or use the Prisma CLI with Bun).
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ─── Supabase (Auth + Storage) ─────────────────────────────────────────────────
# Project URL + anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...replace-me"
# Server-only — never expose. Used by API routes for admin-level operations.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...replace-me"

# ─── Stripe (card deposit) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# ─── SMS gateway (Supabase phone OTP backing provider) ─────────────────────────
# Pick one — Twilio is the default assumption in SPEC.md §3.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace_me"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Or the sender number, if not using a Messaging Service.
TWILIO_FROM_NUMBER="+15555550123"

# ─── App ───────────────────────────────────────────────────────────────────────
# Public base URL for Stripe redirects, magic-link emails, OG tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
